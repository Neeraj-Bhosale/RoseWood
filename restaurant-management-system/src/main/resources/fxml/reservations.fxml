<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.restaurant.controller.ReservationController">
   <children>
      <VBox spacing="2.0">
         <children>
            <Label text="Table Reservation Scheduling" styleClass="page-title" />
            <Label text="Book dining tables in advance with conflict detection and capacity checking" styleClass="page-subtitle" />
         </children>
      </VBox>

      <HBox spacing="15.0" VBox.vgrow="ALWAYS">
         <!-- Left: Reservations Table -->
         <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <children>
               <TableView fx:id="reservationTable" VBox.vgrow="ALWAYS">
                  <columnResizePolicy>
                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                  </columnResizePolicy>
                  <columns>
                     <TableColumn fx:id="colId" prefWidth="35.0" text="ID" />
                     <TableColumn fx:id="colCustomer" prefWidth="120.0" text="Customer" />
                     <TableColumn fx:id="colPhone" prefWidth="105.0" text="Phone" />
                     <TableColumn fx:id="colTable" prefWidth="60.0" text="Table" />
                     <TableColumn fx:id="colDate" prefWidth="90.0" text="Date" />
                     <TableColumn fx:id="colTime" prefWidth="70.0" text="Time" />
                     <TableColumn fx:id="colGuests" prefWidth="55.0" text="Guests" />
                     <TableColumn fx:id="colStatus" prefWidth="90.0" text="Status" />
                  </columns>
               </TableView>
               <HBox spacing="10.0">
                  <children>
                     <Button onAction="#handleCompleteReservation" text="Mark Seated / Completed" styleClass="btn-success" />
                     <Button onAction="#handleCancelReservation" text="Cancel Booking" styleClass="btn-danger" />
                  </children>
               </HBox>
            </children>
         </VBox>

         <!-- Right: Reservation Form -->
         <VBox prefWidth="330.0" minWidth="300.0" maxWidth="350.0" spacing="10.0" styleClass="form-panel">
            <children>
               <Label text="New Booking" styleClass="form-title" />
               <VBox spacing="4.0">
                  <children>
                     <Label text="Customer *" styleClass="form-label" />
                     <ComboBox fx:id="customerCombo" promptText="Select Customer..." maxWidth="Infinity" />
                  </children>
               </VBox>
               <VBox spacing="4.0">
                  <children>
                     <Label text="Table Selection *" styleClass="form-label" />
                     <ComboBox fx:id="tableCombo" promptText="Select Table..." maxWidth="Infinity" />
                  </children>
               </VBox>
               <HBox spacing="10.0">
                  <children>
                     <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <children>
                           <Label text="Date *" styleClass="form-label" />
                           <DatePicker fx:id="datePicker" maxWidth="Infinity" />
                        </children>
                     </VBox>
                     <VBox spacing="4.0" prefWidth="90.0">
                        <children>
                           <Label text="Time (HH:mm) *" styleClass="form-label" />
                           <TextField fx:id="timeField" />
                        </children>
                     </VBox>
                  </children>
               </HBox>
               <VBox spacing="4.0">
                  <children>
                     <Label text="Guest Count *" styleClass="form-label" />
                     <Spinner fx:id="guestsSpinner" maxWidth="Infinity" />
                  </children>
               </VBox>
               <VBox spacing="4.0">
                  <children>
                     <Label text="Special Arrangements" styleClass="form-label" />
                     <TextArea fx:id="requestArea" prefRowCount="2" promptText="Cake cutting, quiet zone, flower bouquet" />
                  </children>
               </VBox>
               <Button onAction="#handleCreateReservation" text="📅 Book Reservation" maxWidth="Infinity" prefHeight="38.0" styleClass="btn-primary" />
            </children>
         </VBox>
      </HBox>
   </children>
</VBox>
