<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.restaurant.controller.ReportController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Analytics &amp; Business Intelligence" styleClass="page-title" />
                  <Label text="Revenue breakdown by category, top selling culinary items, and payment channels" styleClass="page-subtitle" />
               </children>
            </VBox>
            <Button onAction="#handleRefresh" text="🔄 Refresh Analytics" styleClass="btn-secondary" />
         </children>
      </HBox>

      <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: transparent; -fx-background-color: transparent;">
         <content>
            <VBox spacing="20.0" style="-fx-background-color: transparent; -fx-padding: 0 10px 20px 0;">
               <children>
                  <HBox spacing="15.0">
                     <children>
                        <!-- Chart 1: Revenue by Category -->
                        <VBox styleClass="form-panel" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Sales Revenue by Cuisine / Category" styleClass="form-title" />
                              <BarChart fx:id="categorySalesBarChart" legendVisible="false" prefHeight="280.0">
                                 <xAxis>
                                    <CategoryAxis label="Menu Category" />
                                 </xAxis>
                                 <yAxis>
                                    <NumberAxis label="Sales (₹)" />
                                 </yAxis>
                              </BarChart>
                           </children>
                        </VBox>

                        <!-- Chart 2: Payment Channel Breakdown -->
                        <VBox styleClass="form-panel" prefWidth="380.0">
                           <children>
                              <Label text="Payment Method Distribution" styleClass="form-title" />
                              <PieChart fx:id="paymentMethodsPieChart" prefHeight="280.0" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- Chart 3: Top Selling Dishes -->
                  <VBox styleClass="form-panel">
                     <children>
                        <Label text="Top 5 Best-Selling Dishes (Volume)" styleClass="form-title" />
                        <BarChart fx:id="topItemsBarChart" legendVisible="false" prefHeight="240.0">
                           <xAxis>
                              <CategoryAxis label="Dish Name" />
                           </xAxis>
                           <yAxis>
                              <NumberAxis label="Units Ordered" />
                           </yAxis>
                        </BarChart>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</VBox>
